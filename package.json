{
	"name": "@scandinavianairlines/multi-semantic-release",
	"version": "7.2.1",
	"license": "0BSD",
	"author": "Dave Houlbrooke <dave@shax.com>",
	"repository": {
		"type": "git",
		"url": "https://github.com/scandinavianairlines/multi-semantic-release.git"
	},
	"bin": {
		"multi-semantic-release": "./bin/cli.js"
	},
	"files": [
		"README.md",
		"CHANGELOG.md",
		"lib",
		"bin"
	],
	"type": "module",
	"exports": {
		".": "./lib/multiSemanticRelease.js",
		"./*": "./*"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"watch": "vitest",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt 'bin/**/*.js' 'lib/**/*.js' 'test/**/*.js' '!test/fixtures/**' '*.json'",
		"format:check": "oxfmt --check 'bin/**/*.js' 'lib/**/*.js' 'test/**/*.js' '!test/fixtures/**' '*.json'",
		"test": "pnpm lint && pnpm test:unit",
		"test:unit": "vitest run --coverage",
		"prepare": "husky",
		"build": "echo 'There is no need for build' && exit 0"
	},
	"dependencies": {
		"@semrel-extra/topo": "^1.14.0",
		"blork": "^9.3.0",
		"cosmiconfig": "^8.3.6",
		"debug": "^4.3.4",
		"detect-indent": "^7.0.1",
		"detect-newline": "^4.0.1",
		"execa": "^7.1.1",
		"get-stream": "^6.0.1",
		"git-log-parser": "^1.2.0",
		"lodash-es": "^4.17.21",
		"meow": "^12.0.1",
		"promise-events": "^0.2.4",
		"resolve-from": "^5.0.0",
		"semver": "^7.5.3",
		"signale": "^1.4.0",
		"stream-buffers": "^3.0.2"
	},
	"devDependencies": {
		"@commitlint/config-conventional": "^17.6.6",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/git": "^11.0.1",
		"@semantic-release/github": "^12.0.10",
		"@semantic-release/npm": "^13.2.0",
		"@vitest/coverage-v8": "^5.0.5",
		"commitlint": "^17.6.6",
		"file-url": "^4.0.0",
		"husky": "^9.1.7",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0",
		"semantic-release": "^25.0.9",
		"tempy": "^3.0.0",
		"vitest": "^5.0.5"
	},
	"peerDependencies": {
		"semantic-release": ">=25.0.0"
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"engines": {
		"node": "^22.14.0 || >=24.10.0"
	},
	"packageManager": "pnpm@12.15.0"
}
